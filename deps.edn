{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}

        ;; HTTP, routing y negociacion de contenido
        ring/ring-core {:mvn/version "1.15.6"}
        ring/ring-jetty-adapter {:mvn/version "1.15.6"}
        metosin/reitit {:mvn/version "0.11.0"}
        metosin/muuntaja {:mvn/version "0.6.12"}
        metosin/jsonista {:mvn/version "0.3.13"}

        ;; Validacion de dominio y payloads
        metosin/malli {:mvn/version "0.20.3"}

        ;; PostgreSQL (ACID)
        com.github.seancorfield/next.jdbc {:mvn/version "1.4.72"}
        com.github.seancorfield/honeysql {:mvn/version "2.8.85"}
        org.postgresql/postgresql {:mvn/version "42.7.7"}

        ;; Redis (idempotencia y cache)
        com.taoensso/carmine {:mvn/version "3.7.0"}

        ;; RabbitMQ
        com.novemberain/langohr {:mvn/version "5.6.0"}

        ;; Ciclo de vida, configuracion y pasarela
        integrant/integrant {:mvn/version "1.0.1"}
        aero/aero {:mvn/version "1.1.6"}
        hato/hato {:mvn/version "1.0.0"}
        resilience4clj/resilience4clj-circuitbreaker {:mvn/version "0.1.3"}
        resilience4clj/resilience4clj-retry {:mvn/version "0.1.1"}
        resilience4clj/resilience4clj-timelimiter {:mvn/version "0.1.1"}

        ch.qos.logback/logback-classic {:mvn/version "1.5.18"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
