{:port #or [#env PORT #prop PORT "8080"]
 :database-url #or [#env DATABASE_URL #prop DATABASE_URL]
 :redis-url #or [#env REDIS_URL #prop REDIS_URL]
 :rabbitmq-url #or [#env RABBITMQ_URL #prop RABBITMQ_URL ""]
 :rabbitmq-enabled #or [#env RABBITMQ_ENABLED #prop RABBITMQ_ENABLED "false"]
 :rabbitmq-exchange #or [#env RABBITMQ_EXCHANGE #prop RABBITMQ_EXCHANGE "taskit.events"]
 :rabbitmq-dead-letter #or [#env RABBITMQ_DEAD_LETTER_EXCHANGE #prop RABBITMQ_DEAD_LETTER_EXCHANGE "taskit.dlx"]
 :rabbitmq-queue #or [#env RABBITMQ_PAYMENT_QUEUE #prop RABBITMQ_PAYMENT_QUEUE "payment.events"]
 :rabbitmq-routing-key #or [#env RABBITMQ_PAYMENT_ROUTING_KEY #prop RABBITMQ_PAYMENT_ROUTING_KEY "taskit.payment.events"]
 :rabbitmq-task-routing-key #or [#env RABBITMQ_TASK_ROUTING_KEY #prop RABBITMQ_TASK_ROUTING_KEY "taskit.task.events"]
 :rabbitmq-dispute-routing-key #or [#env RABBITMQ_DISPUTE_ROUTING_KEY #prop RABBITMQ_DISPUTE_ROUTING_KEY "taskit.audit.events"]
 :mp-access-token #or [#env MP_ACCESS_TOKEN #prop MP_ACCESS_TOKEN ""]
 :mp-base-url #or [#env MP_BASE_URL #prop MP_BASE_URL "https://api.mercadopago.com"]
 :mp-notification-url #or [#env MP_NOTIFICATION_URL #prop MP_NOTIFICATION_URL ""]}
 :rabbitmq-security-routing-key #or [#env RABBITMQ_SECURITY_ROUTING_KEY "taskit.security.events"]